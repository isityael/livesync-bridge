{
  "name": "livesync-bridge",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26 <27",
    "pnpm": "<13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist coverage",
    "fmt:check": "prettier --check .github/renovate.json .woodpecker/build.yaml .mise.toml package.json pnpm-workspace.yaml tsconfig.json eslint.config.js vitest.config.ts scripts/build.mjs runtime/*.mjs runtime/*.ts stubs/*.ts test/*.ts main.ts Hub.ts Peer.ts PeerCouchDB.ts PeerStorage.ts readme.md",
    "lint": "node --import ./runtime/typescript-eslint-compat.mjs ./node_modules/eslint/bin/eslint.js *.ts stubs/*.ts runtime/*.ts test/*.ts vitest.config.ts",
    "start": "node dist/main.js",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@smithy/md5-js": "^4.5.2",
    "@smithy/middleware-apply-body-checksum": "^4.6.3",
    "@smithy/types": "^4.19.0",
    "@smithy/util-retry": "^4.6.2",
    "@trystero-p2p/nostr": "^0.26.0",
    "brace-expansion": "^5.0.12",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "diff-match-patch": "^1.0.5",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.4",
    "markdown-it": "^15.0.2",
    "minimatch": "^10.2.6",
    "octagonal-wheels": "^0.1.55",
    "pouchdb-adapter-http": "^9.0.0",
    "pouchdb-adapter-idb": "^9.0.0",
    "pouchdb-adapter-indexeddb": "^9.0.0",
    "pouchdb-adapter-memory": "^9.0.0",
    "pouchdb-core": "^9.0.0",
    "pouchdb-errors": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "pouchdb-mapreduce": "^9.0.0",
    "pouchdb-merge": "^9.0.0",
    "pouchdb-replication": "^9.0.0",
    "pouchdb-utils": "^9.0.0",
    "qrcode-generator": "^2.0.4",
    "transform-pouch": "^2.0.0",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/pouchdb": "^6.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "4.0.0-alpha.13",
    "typescript": "7.1.0-dev.20261015.1",
    "typescript-eslint": "8.71.3-alpha.5",
    "typescript-eslint-compiler": "npm:typescript@6.0.3",
    "vitest": "5.0.4"
  }
}
